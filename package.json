{
  "name": "dota2-recommendation",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build:app && npm --prefix frontend run build",
    "test": "npm --prefix backend run test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "copy:data": "npm --prefix backend run copy:data",
    "sync:constants": "npm --prefix backend run sync:constants",
    "sync:meta": "npm --prefix backend run sync:meta",
    "sync:patch": "npm --prefix backend run sync:patch",
    "calculate": "npm --prefix backend run calculate",
    "admin:seed": "npm --prefix backend run admin:seed",
    "profiles:seed": "npm --prefix backend run profiles:seed",
    "cc:seed": "npm --prefix backend run cc:seed"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
