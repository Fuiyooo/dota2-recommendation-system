{
  "name": "dota2-recommendation",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --workspace backend run start:dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm --workspace backend run build && npm --workspace frontend run build",
    "test": "npm --workspace backend run test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "copy:data": "npm --workspace backend run copy:data",
    "sync:constants": "npm --workspace backend run sync:constants",
    "sync:meta": "npm --workspace backend run sync:meta",
    "sync:patch": "npm --workspace backend run sync:patch",
    "calculate": "npm --workspace backend run calculate",
    "admin:seed": "npm --workspace backend run admin:seed",
    "profiles:seed": "npm --workspace backend run profiles:seed",
    "cc:seed": "npm --workspace backend run cc:seed"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
