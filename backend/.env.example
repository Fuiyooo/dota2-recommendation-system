# Development: Postgres lokal via `docker compose up -d`
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dota2?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/dota2?schema=public"

# Production (Supabase, ap-southeast-1) — isi <PASSWORD> dari dashboard.
# Runtime memakai transaction pooler:
# DATABASE_URL="postgresql://postgres.koazebhzzsedcwolvqmz:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Migration & seed memakai session pooler:
# DIRECT_URL="postgresql://postgres.koazebhzzsedcwolvqmz:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

PORT=3000
STRATZ_TOKEN=
STRATZ_BRACKET=DIVINE_IMMORTAL
VALVE_LOCALE=english
PATCH_TARGET=7.41f

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat
ADMIN_JWT_SECRET=ganti-dengan-string-acak-panjang
CORS_ORIGIN=http://localhost:5173
