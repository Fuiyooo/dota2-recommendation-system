{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate:sqlite": "prisma generate --schema prisma/schema.sqlite.prisma",
    "copy:data": "npm run prisma:generate:sqlite && tsx prisma/copy-from-sqlite.ts",
    "test": "vitest run",
    "sync:constants": "npm run build && node dist/scripts/sync-constants.js",
    "sync:meta": "npm run build && node dist/scripts/sync-meta.js",
    "sync:patch": "npm run build && node dist/scripts/validate-patch.js",
    "calculate": "npm run build && node dist/scripts/calculate.js",
    "admin:seed": "npm run build && node dist/scripts/seed-admin.js",
    "profiles:seed": "npm run build && node dist/scripts/seed-damage-profiles.js",
    "cc:seed": "npm run build && node dist/scripts/seed-cc-config.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.1.0",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^3.2.0"
  }
}
